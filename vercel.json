{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/poker/cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily?utc=07",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/daily?utc=08",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/daily?utc=09",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/daily?utc=10",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/daily?utc=11",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/krillion?utc=00",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/krillion?utc=01",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/krillion?utc=02",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/krillion?utc=03",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/krillion?utc=04",
      "schedule": "0 4 * * *"
    }
  ]
}
